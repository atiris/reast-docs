#!/bin/sh
# ROOT_DIR=$(git rev-parse --show-toplevel)

# The build strips types without checking them, so this runs first: it is what
# enforces that every registry entry carries a string for every locale.
npm run check:types || (
  echo "" >&2
  echo "❌ ERROR (husky pre-commit hook): TypeScript check failed." >&2
  echo "   A missing locale key in .vitepress/data/features.ts reports here." >&2
  echo "" >&2
  exit 1
)

npm run build || (
  echo "" >&2
  echo "❌ ERROR (husky pre-commit hook): VitePress build failed (dead links or syntax errors found)." >&2
  echo "   Fix the issues before committing, or bypass with --no-verify." >&2
  echo "" >&2
  exit 1
)

echo "VitePress build passed (husky pre-commit hook)."

# The build only checks the page half of a link; this checks the anchor half,
# which is the half that drifts on the translated pages.
npm run check:anchors || (
  echo "" >&2
  echo "❌ ERROR (husky pre-commit hook): a link points at a heading that does not exist." >&2
  echo "   Slovak headings need an explicit {#english-anchor} wherever another page links to them." >&2
  echo "" >&2
  exit 1
)
